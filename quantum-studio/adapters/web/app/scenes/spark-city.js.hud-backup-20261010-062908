  drawDiscoveryWorldState();
  drawPlayer();
  drawNovaAvatar();
  drawNovaLife();
  drawObjectiveBanner();
  drawQuantumResonance();
  drawNPCInteraction();
  drawObjectiveArrow();
  drawChapter1Objective();
  drawOpeningObjective();

  endCameraRender();

  drawHUD();
  showDiscoveryProgression();

  requestAnimationFrame(render);
}

render();
