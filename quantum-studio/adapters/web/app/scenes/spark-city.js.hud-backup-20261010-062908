function drawPlayer(){

  const mirror=alternate();

  const moving=
    keys.ArrowUp||keys.ArrowDown||
    keys.ArrowLeft||keys.ArrowRight||
    keys.w||keys.a||keys.s||keys.d;

  const bob=Math.sin(
    Date.now()/(moving?90:520)
