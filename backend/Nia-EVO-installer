import { useState, useRef, useEffect } from "react";
import { Terminal as TermIcon, Send, ChevronRight } from "lucide-react";

const API = process.env.NEXT_PUBLIC_API_URL;
const QUICK = ["status","pipeline","whale","metrics","strike","help"];

export default function Terminal() {
  const [lines,   setLines]   = useState([
    { k:"sys", v:"JARVIS v2.1 — NIA-EVO Sovereign Intelligence" },
    { k:"sys", v:"Node 23505 operational. Type 'help' for directives." },
  ]);
  const [input,   setInput]   = useState("");
  const [busy,    setBusy]    = useState(false);
  const [hist,    setHist]    = useState([]);
  const [hIdx,    setHIdx]    = useState(-1);
  const endRef   = useRef(null);
  const inputRef = useRef(null);

  useEffect(() => { endRef.current?.scrollIntoView({ behavior:"smooth" }); }, [lines]);

  async function run(e) {
    e?.preventDefault();
    const cmd = input.trim();
    if (!cmd || busy) return;
    setInput(""); setHIdx(-1);
    setHist(h => [cmd,...h].slice(0,50));
    setLines(l => [...l, { k:"in", v:cmd }]);
    setBusy(true);
    try {
      const r = await fetch(`${API}/cmd`, { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({input:cmd}) });
      const d = await r.json();
      setLines(l => [...l, { k:"out", v: d.response||"—" }]);
    } catch(err) {
      setLines(l => [...l, { k:"err", v:`CONNECTION FAILURE: ${err.message}` }]);
    } finally {
      setBusy(false);
      inputRef.current?.focus();
    }
  }

  function onKey(e) {
    if (e.key==="ArrowUp")   { const i=Math.min(hIdx+1,hist.length-1); setHIdx(i); setInput(hist[i]||""); }
    if (e.key==="ArrowDown") { const i=Math.max(hIdx-1,-1);            setHIdx(i); setInput(i===-1?"":hist[i]||""); }
  }

  const STYLE = { sys:"text-accent/35", in:"text-white/90", out:"text-accent", err:"text-strike" };
  const GLYPH = { sys:"◌", in:"◈", out:"▶", err:"✕" };

  return (
    <section className="bg-panel border border-rim rounded-2xl overflow-hidden">
      {/* Header */}
      <header className="flex items-center gap-2 px-4 py-3 border-b border-rim bg-void/40">
        <TermIcon size={12} className="text-accent" />
        <span className="font-mono text-[9px] text-accent uppercase tracking-[0.2em]">Jarvis Terminal</span>
        <div className="ml-auto flex gap-1.5">
          <div className="w-2.5 h-2.5 rounded-full bg-strike/50" />
          <div className="w-2.5 h-2.5 rounded-full bg-gold/50" />
          <div className="w-2.5 h-2.5 rounded-full bg-accent/50" />
        </div>
      </header>

      {/* Output */}
      <div
        className="h-48 overflow-y-auto p-4 space-y-1.5 bg-void/50 cursor-text"
        onClick={() => inputRef.current?.focus()}
      >
        {lines.map((l,i) => (
          <p key={i} className={`flex gap-2 font-mono text-[10px] leading-relaxed ${STYLE[l.k]||"text-dim"}`}>
            <span className="opacity-40 select-none flex-shrink-0">{GLYPH[l.k]}</span>
            <span className="break-all">{l.v}</span>
          </p>
        ))}
        {busy && <p className="flex gap-2 font-mono text-[10px] text-accent/50"><span className="opacity-40">▶</span><span className="animate-pulse">PROCESSING...</span></p>}
        <div ref={endRef} />
      </div>

      {/* Quick commands */}
      <div className="flex gap-2 px-4 py-2 overflow-x-auto border-t border-rim/50 no-scrollbar">
        {QUICK.map(q => (
          <button key={q} onClick={() => { setInput(q); inputRef.current?.focus(); }}
            className="flex-shrink-0 font-mono text-[8px] uppercase text-dim hover:text-accent border border-rim hover:border-accent/30 rounded-lg px-2 py-1 transition-all">
            {q}
          </button>
        ))}
      </div>

      {/* Input */}
      <form onSubmit={run} className="flex items-center gap-2 px-4 py-3 border-t border-rim bg-void/40">
        <ChevronRight size={12} className="text-accent flex-shrink-0" />
        <input
          ref={inputRef}
          value={input}
          onChange={e => setInput(e.target.value)}
          onKeyDown={onKey}
          placeholder="Enter directive..."
          className="flex-1 bg-transparent text-[10px] font-mono text-white outline-none placeholder:text-dim/40 caret-accent"
          disabled={busy}
          autoComplete="off"
          spellCheck="false"
        />
        <button type="submit" disabled={busy||!input.trim()} className="text-accent disabled:opacity-20 hover:text-white transition-colors">
          <Send size={12} />
        </button>
      </form>
    </section>
  );
}
EOF

