import express            from "express";
import { WebSocketServer } from "ws";
import cors               from "cors";
import { randomUUID }     from "crypto";
import { readFile, writeFile } from "fs/promises";
import { existsSync }     from "fs";
import dotenv             from "dotenv";

dotenv.config();

const PORT         = process.env.PORT         || 3001;
const FRONTEND_URL = process.env.FRONTEND_URL  || "*";
// DB_PATH: use /sdcard/Lexar_Vault/db.json on Termux,
//          ./db.json on Render (set via env var)
const DB_PATH      = process.env.DB_PATH       || "./db.json";

const app = express();
app.use(express.json());
app.use(cors({ origin: FRONTEND_URL, methods: ["GET","POST","PUT","DELETE","OPTIONS"] }));

// ── JSON Database ─────────────────────────────────────────────────
async function readDB() {
  try {
    if (!existsSync(DB_PATH)) await writeDB(seed());
    return JSON.parse(await readFile(DB_PATH, "utf8"));
  } catch { return seed(); }
}
async function writeDB(data) {
  await writeFile(DB_PATH, JSON.stringify(data, null, 2));
}
function seed() {
  return {
    meta:  { operator: "J. LeSane", node: "23505-Sovereign", built: new Date().toISOString() },
    deals: [
      { id: randomUUID(), target: "MD-WHALE",  address: "4722 Chesapeake Dr, Annapolis MD 21401",   value: 125500, arv: 210000, equity: 84500,  status: "ACQUIRING", strategy: "SUBJECT_TO",       priority: "CRITICAL", created: new Date().toISOString() },
      { id: randomUUID(), target: "DC-DUPLEX", address: "1809 Georgia Ave NW, Washington DC 20001", value: 380000, arv: 550000, equity: 170000, status: "ANALYSIS",  strategy: "CREATIVE_FINANCE", priority: "HIGH",     created: new Date().toISOString() },
      { id: randomUUID(), target: "VA-FLIP",   address: "2203 Rebel Court, Richmond VA 23220",      value: 87000,  arv: 145000, equity: 58000,  status: "PIPELINE",  strategy: "WHOLESALE",        priority: "MEDIUM",   created: new Date().toISOString() },
    ],
    commands: [],
  };
}

// ── Broadcast helpers ─────────────────────────────────────────────
const clients = new Set();
const emit = (data) => {
  const msg = JSON.stringify(data);
  clients.forEach(ws => { if (ws.readyState === 1) ws.send(msg); });
};

// ── Routes ────────────────────────────────────────────────────────
app.get("/health", (_, res) => res.json({ status: "SOVEREIGN_ONLINE", node: "23505", ts: Date.now() }));

app.get("/deals", async (_, res) => res.json((await readDB()).deals));

app.post("/deals", async (req, res) => {
  const db   = await readDB();
  const deal = { id: randomUUID(), ...req.body, created: new Date().toISOString() };
  db.deals.push(deal);
  await writeDB(db);
  emit({ type: "DEAL_ADDED", payload: deal });
  res.status(201).json(deal);
});

app.put("/deals/:id", async (req, res) => {
  const db  = await readDB();
  const idx = db.deals.findIndex(d => d.id === req.params.id);
  if (idx === -1) return res.status(404).json({ error: "Not found" });
  db.deals[idx] = { ...db.deals[idx], ...req.body };
  await writeDB(db);
  emit({ type: "DEAL_UPDATED", payload: db.deals[idx] });
  res.json(db.deals[idx]);
});

app.delete("/deals/:id", async (req, res) => {
  const db = await readDB();
  db.deals = db.deals.filter(d => d.id !== req.params.id);
  await writeDB(db);
  emit({ type: "DEAL_REMOVED", payload: { id: req.params.id } });
  res.json({ removed: req.params.id });
});

app.get("/metrics", async (_, res) => {
  const { deals } = await readDB();
  res.json({
    dealCount:   deals.length,
    totalEquity: deals.reduce((s, d) => s + (d.equity || 0), 0),
    totalValue:  deals.reduce((s, d) => s + (d.value  || 0), 0),
    totalArv:    deals.reduce((s, d) => s + (d.arv    || 0), 0),
    liveStrikes: deals.filter(d => d.status === "ACQUIRING").length,
  });
});

app.post("/cmd", async (req, res) => {
  const db  = await readDB();
  const cmd = { id: randomUUID(), input: req.body.input || "", ts: new Date().toISOString() };
  cmd.response = jarvis(cmd.input, db);
  db.commands  = [...(db.commands || []).slice(-99), cmd];
  await writeDB(db);
  emit({ type: "CMD_EXECUTED", payload: cmd });
  res.json({ status: "EXECUTED", ...cmd });
});

// ── Jarvis Intelligence ───────────────────────────────────────────
function jarvis(raw = "", db) {
  const input  = raw.toLowerCase().trim();
  const deals  = db.deals || [];
  const equity = deals.reduce((s, d) => s + (d.equity || 0), 0);
  const $      = n => "$" + Number(n).toLocaleString("en-US");

  if (input === "help" || input === "?")
    return "COMMANDS: status · pipeline · whale · metrics · strike · analyze [target] · ↑↓ history";

  if (input.includes("status"))
    return `SOVEREIGN STATUS — ${deals.length} deals · ${deals.filter(d=>d.status==="ACQUIRING").length} live acquisitions · ${$(equity)} equity locked · All nodes nominal.`;

  if (input.includes("pipeline"))
    return deals.map(d => `[${d.status}] ${d.target} ${$(d.value)} eq:${$(d.equity)}`).join(" | ");

  if (input.includes("whale") || input.includes("md-"))
    return (() => {
      const w = deals.find(d => d.target?.includes("MD"));
      return w ? `MD-WHALE: ${w.status} | Offer ${$(w.value)} | ARV ${$(w.arv)} | Spread ${$(w.equity)} | ${w.strategy}` : "MD-WHALE not in pipeline.";
    })();

  if (input.includes("metric"))
    return `METRICS: ${deals.length} deals · ${$(equity)} equity · ARV pool ${$(deals.reduce((s,d)=>s+(d.arv||0),0))} · ${deals.filter(d=>d.status==="ACQUIRING").length} strikes active`;

  if (input.includes("strike") || input.includes("execute"))
    return "STRIKE ARMED — Subject-To docs ready · Escrow alert queued · Title search requested · Lender notification staged · ETA 72hr. Awaiting authorization.";

  if (input.startsWith("analyze")) {
    const term = input.replace("analyze","").trim().toUpperCase();
    const t    = deals.find(d => d.target?.includes(term) || d.address?.toUpperCase().includes(term));
    return t ? `${t.target}: ${t.address} | Offer ${$(t.value)} | ARV ${$(t.arv)} | Equity ${$(t.equity)} | ${t.strategy} | ${t.priority}` : `"${term}" not found. Try: pipeline`;
  }

  return `JARVIS LOGGED: "${raw}" — No automated action. Awaiting directive.`;
}

// ── WebSocket + Heartbeat ─────────────────────────────────────────
const server = app.listen(PORT, () => {
  console.log(`\n🧠  NIA-EVO BRAIN ONLINE  :${PORT}`);
  console.log(`🏛️   House of Jazzu · ${new Date().toLocaleString()}\n`);
});

const wss = new WebSocketServer({ server });
wss.on("connection", async ws => {
  clients.add(ws);
  ws.send(JSON.stringify({ type: "INIT", payload: await readDB() }));

  // 25s heartbeat keeps Render free tier alive
  const hb = setInterval(() => {
    if (ws.readyState === 1) ws.send(JSON.stringify({ type: "PING", ts: Date.now() }));
    else { clearInterval(hb); clients.delete(ws); }
  }, 25000);

  ws.on("close",   () => { clearInterval(hb); clients.delete(ws); });
  ws.on("error",   () => { clearInterval(hb); clients.delete(ws); });
  ws.on("message", async raw => {
    try {
      const { type, payload } = JSON.parse(raw);
      if (type === "CMD") {
        const db   = await readDB();
        const resp = jarvis(payload, db);
        ws.send(JSON.stringify({ type: "CMD_RESPONSE", payload: resp }));
      }
    } catch { /* ignore */ }
  });
});
EOF

