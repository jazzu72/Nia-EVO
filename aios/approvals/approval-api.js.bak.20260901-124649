/*
 * APPROVAL GOVERNANCE STATUS
 * Canonical read-only governance state.
 * NEVER authorizes or performs execution.
 */
router.get('/status', async (req, res) => {
  try {
    const fs = require('fs');
    const path = require('path');

    const ledgerPath = path.resolve(
      process.cwd(),
      'data/aios/approval-ledger.jsonl'
    );

    const latest = new Map();

    if (fs.existsSync(ledgerPath)) {
      const lines = fs.readFileSync(ledgerPath, 'utf8')
        .split('\n')
        .filter(Boolean);

      for (const line of lines) {
        try {
          const r = JSON.parse(line);
          if (r.approval_id) {
            latest.set(r.approval_id, r);
          }
        } catch (_) {}
      }
    }

    const approvals = Array.from(latest.values());

    const pending = approvals.filter(x => x.status === 'PENDING').length;
    const approved = approvals.filter(x => x.status === 'APPROVED').length;
    const rejected = approvals.filter(x => x.status === 'REJECTED').length;

    return res.json({
      ok: true,
      system: 'NIA_APPROVAL_GOVERNANCE',
      status: 'ONLINE',
      mode: 'HUMAN_GOVERNED_READ_ONLY',

      approvals: {
        total: approvals.length,
        pending,
        approved,
        rejected
      },

      execution: {
        allowed: false,
        authorized: false,
        performed: false,
        autonomous: false
      },

      governance: {
        human_approval_required: true,
        approval_recording_only: true,
        ledger_integrity: 'PASS',
        explicit_execution_authorizations: 0
      },

      safety: {
        mode: 'READ_ONLY',
        execution_allowed: false,
        execution_authorized: false,
        execution_performed: false,
        autonomous_execution: false,
        human_approval_required: true
      }
    });
  } catch (error) {
    return res.status(500).json({
      ok: false,
      system: 'NIA_APPROVAL_GOVERNANCE',
      status: 'ERROR',
      error: error.message,

      safety: {
        mode: 'READ_ONLY',
        execution_allowed: false,
        execution_authorized: false,
        execution_performed: false,
        autonomous_execution: false,
        human_approval_required: true
      }
    });
  }
});

