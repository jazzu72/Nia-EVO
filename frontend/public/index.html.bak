<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nia Capital OS</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body { background: #151e2a; color: #e8edf5; font-family: system-ui, sans-serif; }
        .sidebar { background: #151e2a; border-right: 1px solid #2a3548; }
        .sidebar a.active { background: #6c5ce7; color: #fff; }
        .card { background: #151e2a; border: 1px solid #2a3548; border-radius: 12px; padding: 1.5rem; }
        .stat-value { font-size: 2rem; font-weight: 700; color: #8993a4; }
        .log-entry { border-bottom: 1px solid #1a2533; padding: 0.5rem 0; }
        .log-time { color: #64748b; font-size: 0.75rem; }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #151e2a; }
        ::-webkit-scrollbar-thumb { background: #2a3548; border-radius: 4px; }
    </style>
</head>
<body>
    <div class="flex h-screen bg-background">
        <!-- ─── SIDEBAR ─── -->
        <aside class="sidebar w-64 flex flex-col h-full p-4">
            <h1 class="text-xl font-bold mb-6 bg-gradient-to-r from-[#6c5ce7] to-[#a78bfa] bg-clip-text text-transparent">
                🏰 Nia Capital OS
            </h1>
            <nav class="space-y-2 flex-1">
                <a href="/" class="flex items-center gap-2 p-2 rounded-lg text-gray-400 hover:text-white transition-colors active">
                    <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
                    Dashboard
                </a>
                <a href="/chat" class="flex items-center gap-2 p-2 rounded-lg text-gray-400 hover:text-white transition-colors">
                    <i data-lucide="message-square" class="w-5 h-5"></i>
                    Chat
                </a>
                <a href="/real-estate" class="flex items-center gap-2 p-2 rounded-lg text-gray-400 hover:text-white transition-colors">
                    <i data-lucide="home" class="w-5 h-5"></i>
                    Real Estate
                </a>
                <a href="/grants" class="flex items-center gap-2 p-2 rounded-lg text-gray-400 hover:text-white transition-colors">
                    <i data-lucide="file-text" class="w-5 h-5"></i>
                    Grants
                </a>
                <a href="/treasury" class="flex items-center gap-2 p-2 rounded-lg text-gray-400 hover:text-white transition-colors">
                    <i data-lucide="wallet" class="w-5 h-5"></i>
                    Treasury
                </a>
            </nav>
            <div class="border-t border-[#2a3548] pt-4 mt-auto">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-gradient-to-r from-[#6c5ce7] to-[#a78bfa] flex items-center justify-center text-xs font-bold">
                        NJ
                    </div>
                    <div>
                        <p class="text-sm font-medium">Nia Jazzu</p>
                        <p class="text-xs text-gray-500">CEO</p>
                    </div>
                </div>
            </div>
        </aside>

        <!-- ─── MAIN CONTENT ─── -->
        <main class="flex-1 overflow-auto p-8" id="main-content">
            <div id="page-content">
                <!-- Rendered by JS below -->
            </div>
        </main>
    </div>

    <script>
        lucide.createIcons();

        const pages = {
            '/': dashboardPage,
            '/chat': chatPage,
            '/real-estate': realEstatePage,
            '/grants': grantsPage,
            '/treasury': treasuryPage,
        };

        function renderPage(path) {
            const content = pages[path] || pages['/'];
            document.getElementById('page-content').innerHTML = content;
            lucide.createIcons();
            document.querySelectorAll('.sidebar a').forEach(link => {
                link.classList.toggle('active', link.getAttribute('href') === path);
            });
        }

        function dashboardPage() {
            return `
                <div class="space-y-6">
                    <h2 class="text-2xl font-bold">Dashboard</h2>
                    <p class="text-gray-400">Welcome back, Nia.</p>
                    <div class="grid grid-cols-4 gap-4">
                        <div class="card"><h3 class="text-sm text-gray-400">Revenue</h3><p class="stat-value">$0</p></div>
                        <div class="card"><h3 class="text-sm text-gray-400">Pipeline</h3><p class="stat-value">$0</p></div>
                        <div class="card"><h3 class="text-sm text-gray-400">Active Leads</h3><p class="stat-value">0</p></div>
                        <div class="card"><h3 class="text-sm text-gray-400">Deals Closed</h3><p class="stat-value">0</p></div>
                    </div>
                    <div class="card">
                        <h3 class="text-lg font-medium mb-4">Live Activity Feed</h3>
                        <div class="space-y-2 max-h-64 overflow-y-auto" id="feed">
                            <div class="log-entry"><span class="log-time">—</span> No recent activity</div>
                        </div>
                    </div>
                </div>
            `;
        }

        function chatPage() {
            return `
                <div class="h-full flex flex-col">
                    <h2 class="text-2xl font-bold">Chat</h2>
                    <p class="text-gray-400">Seller conversations</p>
                    <div class="flex-1 overflow-y-auto space-y-4 py-4" id="chat-messages">
                        <div class="flex justify-start"><div class="bg-[#151e2a] border border-[#2a3548] rounded-xl p-3 max-w-[70%]"><p class="text-sm">I have a property I want to sell.</p><p class="text-xs text-gray-500 mt-1">2 min ago</p></div></div>
                        <div class="flex justify-end"><div class="bg-[#6c5ce7] text-white rounded-xl p-3 max-w-[70%]"><p class="text-sm">Great! What is the address?</p><p class="text-xs opacity-70 mt-1">1 min ago</p></div></div>
                    </div>
                    <div class="flex gap-2 pt-4 border-t border-[#2a3548]">
                        <input type="text" placeholder="Type a message..." class="flex-1 bg-[#151e2a] border border-[#2a3548] rounded-lg px-4 py-2 focus:outline-none focus:border-[#6c5ce7]">
                        <button class="bg-[#6c5ce7] hover:bg-[#5a4bd1] text-white px-4 py-2 rounded-lg">Send</button>
                    </div>
                </div>
            `;
        }

        function realEstatePage() {
            return `
                <div class="space-y-6">
                    <h2 class="text-2xl font-bold">Real Estate</h2>
                    <p class="text-gray-400">Active properties and deals</p>
                    <div class="grid gap-4">
                        <div class="bg-[#151e2a] rounded-xl p-4 border border-[#2a3548] flex items-center justify-between">
                            <div class="flex items-center gap-4"><div class="w-12 h-12 rounded-lg bg-[#6c5ce7]/20 flex items-center justify-center"><i data-lucide="home" class="w-6 h-6 text-[#6c5ce7]"></i></div><div><p class="font-medium">123 Main St, Norfolk, VA</p><p class="text-sm text-gray-400">Status: Inspection</p></div></div>
                            <div class="text-right"><p class="font-medium text-green-400">$85,000</p><p class="text-xs text-gray-400">Est. offer</p></div>
                        </div>
                        <div class="bg-[#151e2a] rounded-xl p-4 border border-[#2a3548] flex items-center justify-between">
                            <div class="flex items-center gap-4"><div class="w-12 h-12 rounded-lg bg-[#6c5ce7]/20 flex items-center justify-center"><i data-lucide="home" class="w-6 h-6 text-[#6c5ce7]"></i></div><div><p class="font-medium">456 Oak Ave, Norfolk, VA</p><p class="text-sm text-gray-400">Status: Negotiating</p></div></div>
                            <div class="text-right"><p class="font-medium text-green-400">$75,000</p><p class="text-xs text-gray-400">Est. offer</p></div>
                        </div>
                    </div>
                </div>
            `;
        }

        function grantsPage() {
            return `
                <div class="space-y-6">
                    <h2 class="text-2xl font-bold">Grants</h2>
                    <p class="text-gray-400">Manage grant applications</p>
                    <div class="grid gap-4">
                        <div class="bg-[#151e2a] rounded-xl p-4 border border-[#2a3548] flex items-center justify-between">
                            <div class="flex items-center gap-4"><div class="w-12 h-12 rounded-lg bg-blue-500/20 flex items-center justify-center"><i data-lucide="file-text" class="w-6 h-6 text-blue-400"></i></div><div><p class="font-medium">NSF AI Research</p><p class="text-sm text-gray-400">$500,000</p></div></div>
                            <span class="px-2 py-1 bg-green-500/20 text-green-400 rounded-full text-xs font-medium">Submitted</span>
                        </div>
                    </div>
                </div>
            `;
        }

        function treasuryPage() {
            return `
                <div class="space-y-6">
                    <h2 class="text-2xl font-bold">Treasury</h2>
                    <p class="text-gray-400">Balance and transactions</p>
                    <div class="card"><h3 class="text-lg font-medium">Available Balance</h3><p class="stat-value">$85,000</p></div>
                    <div class="bg-[#151e2a] rounded-xl p-4 border border-[#2a3548] flex items-center justify-between">
                        <div class="flex items-center gap-4"><div class="w-10 h-10 rounded-lg bg-green-500/20 flex items-center justify-center"><i data-lucide="arrow-up-right" class="w-5 h-5 text-green-400"></i></div><div><p class="font-medium">Deposit</p><p class="text-sm text-gray-400">Deal closed</p></div></div>
                        <div class="text-right"><p class="font-medium text-green-400">+$85,000</p><p class="text-xs text-gray-400">2026-07-18</p></div>
                    </div>
                </div>
            `;
        }

        document.querySelectorAll('.sidebar a').forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                const path = link.getAttribute('href');
                window.history.pushState({}, '', path);
                renderPage(path);
            });
        });

        window.addEventListener('popstate', () => renderPage(window.location.pathname));

        renderPage(window.location.pathname);
    </script>
</body>
</html>
